# ---- Storage ----
# 'local' (default) keeps using Server/inputs and Server/outputs on disk.
# 's3' routes all inputs/outputs through the S3 bucket below.
STORAGE_BACKEND=local
S3_BUCKET=landwise-results
S3_REGION=ap-south-1
S3_PRESIGN_EXPIRES=3600
# When 'true', local outputs/validate/<rid> and inputs/validate/<rid> are
# deleted after each run completes (and is uploaded to S3). Subsequent reads
# pull from S3 on demand. Leave 'false' until you've verified everything.
S3_CLEANUP_LOCAL_AFTER_RUN=false
AWS_ACCESS_KEY_ID=ASIATOT4F5IUTTD5UGFR
AWS_SECRET_ACCESS_KEY=1kE+7d5lAPq//x/6QNkHWD6oUz2K4gVCmsBt6ptM

# ---- DB ----
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/landwise

# ---- AI ----
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# ---- Checklist Tier-B external data sources ----
# Each checklist compliance/litigation check stays 'pending: requires <source>'
# until its endpoint is configured here, at which point it activates
# automatically. Point each at your licensed government/commercial JSON API
# (and adjust the _fetch() body in services/checklist_engine/external_sources.py
# to match that provider's response shape). Leave blank to keep the check pending.
# CRZ_DATA_URL=               # CMP-02  Coastal Regulation Zone lookup
# FOREST_DATA_URL=            # CMP-01  forest/wetland GIS layer
# AREGISTER_API_URL=          # CMP-01  revenue 'A-Register' classification
# DTCP_API_URL=               # CMP-03  DTCP/CMDA layout-approval lookup
# ECOURTS_API_URL=            # ENC-04  eCourts case search (augments EC)
# ECOURTS_API_KEY=            # ENC-04  (optional) eCourts API key
# GUIDELINE_VALUE_API_URL=    # TNREGINET guideline-value (valuation; unbound)
